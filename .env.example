# Copy this file to .env and fill in the values. Do NOT commit .env to git

# Initial Grafana login
GF_SECURITY_ADMIN_USER=admin
GF_SECURITY_ADMIN_PASSWORD=ganti_password_ini

# Telegram bot for alerts (create via @BotFather in Telegram)
TELEGRAM_BOT_TOKEN=123456789:AAExxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Your chat ID / group. Check it via @userinfobot or https://api.telegram.org/bot<token>/getUpdates
TELEGRAM_CHAT_ID=123456789
