    {
      "id": 50,
      "title": "🏥 Host Health — all site hosts (pve, Target-1, Target-2)",
      "type": "table",
      "gridPos": {
        "h": 8,
        "w": 24,
        "x": 0,
        "y": 5
      },
      "datasource": "Prometheus",
      "targets": [
        {
          "datasource": "Prometheus",
          "refId": "A",
          "format": "table",
          "instant": true,
          "expr": "up{job=\"site-node-exporter\"}",
          "legendFormat": "Status"
        },
        {
          "datasource": "Prometheus",
          "refId": "B",
          "format": "table",
          "instant": true,
          "expr": "100 - (avg by (instance) (rate(node_cpu_seconds_total{job=\"site-node-exporter\", mode=\"idle\"}[5m])) * 100)",
          "legendFormat": "CPU %"
        },
        {
          "datasource": "Prometheus",
          "refId": "C",
          "format": "table",
          "instant": true,
          "expr": "(1 - (node_memory_MemAvailable_bytes{job=\"site-node-exporter\"} / node_memory_MemTotal_bytes{job=\"site-node-exporter\"})) * 100",
          "legendFormat": "Mem %"
        },
        {
          "datasource": "Prometheus",
          "refId": "D",
          "format": "table",
          "instant": true,
          "expr": "(1 - (node_filesystem_avail_bytes{job=\"site-node-exporter\", mountpoint=\"/\"} / node_filesystem_size_bytes{job=\"site-node-exporter\", mountpoint=\"/\"})) * 100",
          "legendFormat": "Disk / %"
        },
        {
          "datasource": "Prometheus",
          "refId": "E",
          "format": "table",
          "instant": true,
          "expr": "(time() - node_boot_time_seconds{job=\"site-node-exporter\"}) / 86400",
          "legendFormat": "Uptime (d)"
        }
      ],
      "options": {
        "showHeader": true,
        "cellHeight": "sm",
        "sortBy": [
          {
            "displayName": "Instance",
            "desc": false
          }
        ],
        "sortDesc": false,
        "wrapHeaderText": false
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "auto",
            "cellOptions": {
              "type": "auto"
            }
          },
          "unit": "short",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "yellow",
                "value": 70
              },
              {
                "color": "red",
                "value": 85
              }
            ]
          }
        }
      },
      "transformations": [
        {
          "id": "merge",
          "options": {}
        },
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true
            },
            "renameByName": {
              "Value #A": "Status",
              "Value #B": "CPU %",
              "Value #C": "Mem %",
              "Value #D": "Disk %",
              "Value #E": "Uptime (d)"
            }
          }
        }
      ]
    },
