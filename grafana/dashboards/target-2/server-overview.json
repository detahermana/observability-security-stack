{
  "title": "site Server Overview",
  "uid": "site-overview",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "tags": [
    "site",
    "proxmox",
    "node-exporter"
  ],
  "templating": {
    "list": [
      {
        "name": "instance",
        "label": "Instance",
        "type": "query",
        "datasource": "Prometheus",
        "query": "label_values(node_uname_info{job=\"site-node-exporter\"}, instance)",
        "refresh": 2,
        "includeAll": true,
        "multi": true,
        "allValue": ".+",
        "current": {}
      }
    ]
  },
  "panels": [
    {
      "id": 100,
      "title": "",
      "type": "text",
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "datasource": null,
      "targets": [],
      "options": {
        "mode": "html",
        "content": "<div style='background-color:rgba(33,150,243,0.15); padding:8px 16px; border-left:4px solid #2196f3; height:100%; display:flex; align-items:center;'><span style='font-size:18px; font-weight:600;'>🖥️ Node Overview — Proxmox Host &amp; VM</span><span style='margin-left:auto; color:#4caf50;'>🟢 Real-time metrics</span></div>"
      }
    },
    {
      "id": 30,
      "title": "Hosts UP",
      "type": "stat",
      "gridPos": {
        "h": 4,
        "w": 3,
        "x": 0,
        "y": 1
      },
      "datasource": "Prometheus",
      "targets": [
        {
          "expr": "sum(up{job=\"site-node-exporter\"}) / count(up{job=\"site-node-exporter\"}) * 100",
          "legendFormat": "UP"
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "background",
        "graphMode": "area",
        "textMode": "value_and_name",
        "justifyMode": "center",
        "orientation": "auto",
        "textSize": "auto"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "yellow",
                "value": 50
              },
              {
                "color": "green",
                "value": 100
              }
            ]
          },
          "mappings": [],
          "decimals": null
        },
        "overrides": []
      }
    },
