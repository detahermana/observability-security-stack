# Wazuh environment variables.
# Loaded via the `env_file` directive in wazuh/docker-compose.yml.
#
# HOW TO FILL IN FOR PRODUCTION:
#   1. Copy this file to .env (do not commit it): `cp wazuh/.env.example wazuh/.env`
#   2. Generate a strong password: `openssl rand -base64 24`
#   3. For GitLab CI/CD: create a File-type CI/CD Variable `PROD_WAZUH_ENV_FILE`
#      whose contents are a copy of the production .env (identical to steps 1-2).
#
# EXAMPLE strong passwords (do not use these):
#   WAZUH_INDEXER_ADMIN_PASSWORD=StrongAdminPassword123!
#   WAZUH_DASHBOARD_PASSWORD=AnotherStrongPassword456@

# Wazuh stack version (kept in sync across indexer, manager, dashboard)
WAZUH_VERSION=4.x.y

# Indexer admin password (default username = "admin")
# Used for: the indexer HTTP API, and the dashboard connecting to the indexer
WAZUH_INDEXER_ADMIN_PASSWORD=CHANGEME_strong_password_here

# Dashboard user for the indexer (default username = "kibanaserver")
# The password can be the same as or different from the indexer admin. Simplified for single-node.
WAZUH_DASHBOARD_USERNAME=kibanaserver
WAZUH_DASHBOARD_PASSWORD=CHANGEME_another_strong_password

# Memory budget per service
# - WAZUH_MANAGER_MEMORY: limit on the analysis process inside the manager container
#   (compose default: 512m). Raise it if there are many agents.
# - OPENSEARCH_JAVA_OPTS: JVM heap for the OpenSearch indexer. -Xms must equal -Xmx.
#   Recommendation: 1/2 of the container memory_limit (compose: 2g -> heap max 1g)
WAZUH_MANAGER_MEMORY=512m
OPENSEARCH_JAVA_OPTS=-Xms1g -Xmx1g